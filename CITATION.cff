    given-names: Akshat
repository-code: "https://github.com/AkshatTm/Vidura-IPO-X-Ray"
license: MIT
version: "1.1"
date-released: "2026-11-07"
keywords:
  - IPO
  - red herring prospectus
  - document understanding
  - retrieval-augmented generation
  - India
