# FinSight environment variables (names only; never commit real values).
# Copy to .env locally, or set them as Cloud Run / Vercel secrets. See docs/phase2/HOSTING_SETUP_STEPS.md.

# Backend
FINSIGHT_PROFILE=dev_light            # dev_light | full | cloud | cloud_gpu | deploy_cpu
UPLOADS_ENABLED=true                  # kill switch: false stops all uploads
FINSIGHT_DB__URL=                     # Supabase pooler URL (port 6543, transaction mode)
FINSIGHT_STORAGE__BUCKET=             # GCS bucket name
FINSIGHT_AUTH__SUPABASE_URL=          # https://<project>.supabase.co (JWKS is read from here)
FINSIGHT_AUTH__JWT_SECRET=            # only if the project still signs with HS256
FINSIGHT_AUTH__ADMIN_EMAILS=          # JSON list, e.g. ["you@example.com"]
FINSIGHT_SIMPLIFY__VLLM_URL=          # optional GPU path only
GCP_PROJECT=
GCP_REGION=asia-southeast1

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
