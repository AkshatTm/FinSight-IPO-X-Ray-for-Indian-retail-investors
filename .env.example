# FinSight environment variables (names only; never commit real values).
# Copy to .env. Everything is optional on the laptop; Supabase sign-in and Postgres are opt-in.
# See docs/phase2/HOSTING_SETUP_STEPS.md (B-ADR-16: no Google Cloud).

# Backend
FINSIGHT_PROFILE=dev_light            # dev_light | full | deploy_cpu
UPLOADS_ENABLED=true                  # kill switch: false stops all uploads
FINSIGHT_DB__URL=                     # optional Supabase pooler URL (port 6543, transaction mode)
FINSIGHT_AUTH__SUPABASE_URL=          # https://<project>.supabase.co (JWKS is read from here)
FINSIGHT_AUTH__JWT_SECRET=            # only if the project still signs with HS256
FINSIGHT_AUTH__ADMIN_EMAILS=          # JSON list, e.g. ["you@example.com"]

# Frontend
FINSIGHT_API_ORIGIN=                  # where Next.js rewrites /api/* (default http://localhost:8000)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 3 (Colab / Hugging Face): names only
HF_TOKEN=                             # write token for private model repos (scripts/hf_upload.py)
HF_USER=AkshatTm
