# Names only. On Vercel set these in Project Settings -> Environment Variables.
# Origin of the deployed API (the Hugging Face Space direct URL). Next rewrites /api/* to it.
FINSIGHT_API_ORIGIN=https://YOUR-USER-finsight-api.hf.space
# Leave unset in production: 1 would serve fixtures instead of the real API.
NEXT_PUBLIC_USE_MOCKS=
