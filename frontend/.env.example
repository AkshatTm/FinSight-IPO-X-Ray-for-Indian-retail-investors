# Names only. On Vercel set these in Project Settings -> Environment Variables.
# Origin of the deployed API (the Cloud Run service URL, no trailing slash). Next rewrites /api/*
# to it; unset means http://localhost:8000.
FINSIGHT_API_ORIGIN=
# Supabase project (Google sign-in). Unset means auth "off": one local user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Leave unset in production: 1 would serve fixtures instead of the real API.
NEXT_PUBLIC_USE_MOCKS=
